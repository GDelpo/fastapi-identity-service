# =============================================================================
# Identity Service - Environment Configuration
# =============================================================================
# Copy to .env and configure for your environment
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# =============================================================================
# Core Settings
# =============================================================================
# DEBUG controls multiple behaviors:
#   DEBUG=true  → environment=development, log_level=DEBUG, hot reload enabled
#   DEBUG=false → environment=production, log_level=INFO, security warnings active
DEBUG=false

# Override environment name if needed (optional, derived from DEBUG)
# ENVIRONMENT=staging

# =============================================================================
# Database (PostgreSQL) - REQUIRED
# =============================================================================
DB_HOST=localhost
DB_USER=identity_user
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB_NAME=identity_db
# DB_PORT=5432  # Uncomment only if not using default

# =============================================================================
# Redis - REQUIRED
# =============================================================================
REDIS_HOST=localhost
# REDIS_PORT=6379      # Uncomment only if not using default
# REDIS_DB=0           # Uncomment only if not using default
# REDIS_PASSWORD=      # Uncomment if Redis requires auth

# =============================================================================
# JWT Authentication - REQUIRED
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_A_SECURE_KEY_MIN_32_CHARS

# =============================================================================
# Admin User Seed - REQUIRED for first migration
# =============================================================================
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD
ADMIN_EMAIL=admin@yourdomain.com

# =============================================================================
# CORS - REQUIRED for production
# =============================================================================
# Never use ["*"] in production!
CORS_ORIGINS=["https://your-frontend.com"]

# =============================================================================
# Mail Sender Service - Optional
# =============================================================================
# Full URL to mailsender emails endpoint
# Examples:
#   Local:   http://localhost:8081/api/v1/emails
#   Docker:  http://mailsender_api:8081/api/v1/emails
#   Traefik: http://dominio/mailsender/api/v1/emails
MAILSENDER_URL=http://localhost:8081/api/v1/emails
# MAILSENDER_TIMEOUT=30

# =============================================================================
# LDAP Integration - Optional
# =============================================================================
# LDAP_URL=ldap://your-ldap-server.example.com:389
# LDAP_ADMIN_USERNAME=cn=admin,dc=example,dc=com
# LDAP_ADMIN_PASSWORD=
# LDAP_SEARCH_BASES=["ou=users,dc=example,dc=com"]
# LDAP_OU_TO_AVOID=["ou=system,dc=example,dc=com"]
# LDAP_ATTR_TO_RETRIEVE=["cn","mail","sAMAccountName"]

# =============================================================================
# Data Directory (docker-compose.prod.traefik.yml) - Optional
# =============================================================================
# Host path where Postgres and Redis data will be persisted.
# DATA_DIR=./data

# =============================================================================
# Advanced Settings - Optional (defaults shown)
# =============================================================================
# LOG_FORMAT=json              # json or text
# LOG_FILE=                    # Path to log file (also logs to stdout)
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_DURATION_MINUTES=15
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60